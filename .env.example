# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# Add this in Vercel Environment Variables to use Supabase as the app database.
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Secret key allowing backend access to Supabase tables.
# Add this in Vercel Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=""

# APP_MASTER_KEY: Optional 64-char hex key used to encrypt employee secrets at rest.
# If omitted, auto-generated securely.
APP_MASTER_KEY=""

# GOOGLE_CLOUD_PROJECT: Assigned Google Cloud Project ID
GCP_PROJECT_ID="gen-lang-client-0447436480"
